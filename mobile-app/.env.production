# 生产环境 - mobile-app(Android App / web 版均使用)
# App(Capacitor)与 web /mobile/ 版打包均走生产 API 域名
VITE_API_BASE=https://crm.andejiazheng.com/api

# 应用内版本检查清单 URL（静态 version.json）。留空 = 关闭版本检查。
# 示例：VITE_UPDATE_MANIFEST_URL=https://crm.andejiazheng.com/app/version.json
VITE_UPDATE_MANIFEST_URL=https://crm.andejiazheng.com/app/version.json
