<view class="page">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-text">加载中...</view>
  </view>

  <block wx:elif="{{contract}}">
    <!-- 合同状态横幅 -->
    <view class="status-banner status-{{contract.displayStatus || contract.contractStatus}}">
      <text class="status-text">{{contract.statusText}}</text>
    </view>

    <!-- 客户信息 -->
    <view class="section">
      <view class="section-title">客户信息</view>
      <view class="row"><text class="label">姓　　名</text><text class="value">{{contract.customerName}}</text></view>
      <view class="row"><text class="label">手　机　号</text><text class="value">{{contract.customerPhone}}</text></view>
    </view>

    <!-- 服务信息 -->
    <view class="section">
      <view class="section-title">服务信息</view>
      <view class="row"><text class="label">服务类型</text><text class="value">{{contract.serviceTypeText}}</text></view>
      <view class="row">
        <text class="label">{{contract.paymentMode === 'installment' ? '收款总额' : '服务费用'}}</text>
        <view class="value value-inline">
          <text class="value-amount">¥{{contract.paymentMode === 'installment' ? contract.paymentSummary.expectedText : contract.serviceFee}} 元{{contract.isV2 && isMultiPaymentPlan ? '（分' + paymentProgress.payments.length + '笔收取）' : ''}}</text>
          <text wx:if="{{contract.paymentStatus === 'paid'}}" class="value-paid-tag">✓ 已结清</text>
          <text wx:elif="{{contract.paymentStatus === 'partial'}}" class="value-partial-tag">部分支付</text>
          <text wx:elif="{{contract.paymentStatus === 'refunded'}}" class="value-refund-tag">已退款</text>
        </view>
      </view>
      <view wx:for="{{contract.oneTimeExtraPaymentItems}}" wx:key="index" class="row">
        <text class="label">{{item.displayLabel}}</text>
        <text class="value">¥{{item.amount}} 元</text>
      </view>
      <block wx:if="{{contract.paymentSummary.hasPaymentInfo}}">
        <view wx:if="{{contract.paymentMode !== 'installment'}}" class="row"><text class="label">应付金额</text><text class="value">¥{{contract.paymentSummary.expectedText}} 元</text></view>
        <view class="row"><text class="label">已付金额</text><text class="value payment-received">¥{{contract.paymentSummary.receivedText}} 元</text></view>
        <view class="row" wx:if="{{contract.paymentSummary.status === 'partial'}}"><text class="label">待付金额</text><text class="value payment-remaining">¥{{contract.paymentSummary.remainingText}} 元</text></view>
      </block>
      <view class="row"><text class="label">开始日期</text><text class="value">{{contract.startDateFmt || '待定'}}</text></view>
      <view class="row"><text class="label">结束日期</text><text class="value">{{contract.endDateFmt || '待定'}}</text></view>
      <view class="row"><text class="label">合同期限</text><text class="value">{{contract.contractDuration || '—'}}</text></view>
    </view>

    <!-- ═══ 支付按钮区（旧版内联按钮已撤，状态动作统一到底部悬浮条）═══
         兜底按钮：付完款回到小程序发现状态没同步时点这个（保留为内嵌快捷链接） -->
    <view wx:if="{{contract.showPay}}" class="section">
      <view class="pay-btn-refresh" bindtap="manualRefreshPayment">我已支付？点此刷新</view>
    </view>

    <!-- 仅两笔及以上显示分笔支付进度；单笔服务费不重复展示为“第1笔”。 -->
    <view class="section" wx:if="{{contract.isV2 && paymentProgress && isMultiPaymentPlan}}">
      <view class="section-title">支付进度</view>
      <!-- 进度条 -->
      <view class="progress-bar-wrap">
        <view class="progress-bar">
          <view class="progress-filled" style="width: {{paymentProgress.totalAmount > 0 ? (paymentProgress.receivedAmount / paymentProgress.totalAmount * 100) : 0}}%"></view>
        </view>
        <view class="progress-text-row">
          <text class="progress-received">已收 ¥{{paymentProgress.receivedAmount || 0}}</text>
          <text class="progress-total">/ 共 ¥{{paymentProgress.totalAmount || 0}}</text>
        </view>
      </view>
      <!-- 每笔明细 -->
      <view class="payment-list">
        <view class="payment-item {{item.status === 'paid' ? 'item-paid' : 'item-pending'}}" wx:for="{{paymentProgress.payments}}" wx:key="sequenceNo">
          <view class="payment-item-left">
            <text class="payment-seq">第{{item.sequenceNo}}笔</text>
            <text class="payment-label">{{item.label}}</text>
          </view>
          <view class="payment-item-right">
            <text class="payment-amount">¥{{item.amount}}</text>
            <text class="payment-status status-{{item.status}}">{{item.status === 'paid' ? '✓ 已支付' : '待支付'}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 阿姨信息 -->
    <view class="section">
      <view class="section-title-row">
        <text class="section-title">服务阿姨</text>
        <view wx:if="{{contract.onboardConfirmed}}" class="onboard-done">✓ 已确认上户</view>
      </view>
      <view class="row"><text class="label">阿姨姓名</text><text class="value">{{contract.nannyName}}</text></view>
      <view class="row"><text class="label">阿姨工资</text><text class="value">¥{{contract.nannySalary}} 元/月</text></view>
      <view class="row" wx:if="{{contract.nannyPhone}}">
        <text class="label">阿姨电话</text>
        <view class="value-row">
          <text class="value">{{contract.nannyPhone}}</text>
          <view class="call-btn" bindtap="callNanny">拨打</view>
        </view>
      </view>
    </view>

    <!-- 签约进度 -->
    <view class="section" wx:if="{{contract.hasSigning}}">
      <view class="section-title">签约进度</view>
      <view class="signer-row">
        <text class="signer-label">甲方（您）</text>
        <text class="signer-status {{contract.customerStatus === 'signed' ? 'done' : contract.customerStatus === 'signing' ? 'signing' : 'pending'}}">
          {{contract.customerStatus === 'signed' ? '✓ 已签署' : contract.customerStatus === 'signing' ? '签约中' : '待签署'}}
        </text>
      </view>
      <view class="signer-row">
        <text class="signer-label">乙方（阿姨）</text>
        <text class="signer-status {{contract.nannyStatus === 'signed' ? 'done' : contract.nannyStatus === 'signing' ? 'signing' : 'pending'}}">
          {{contract.nannyStatus === 'signed' ? '✓ 已签署' : contract.nannyStatus === 'signing' ? '签约中' : '待签署'}}
        </text>
      </view>
    </view>

    <!-- 上户确认时间（已确认时显示） -->
    <view class="section" wx:if="{{contract.onboardConfirmed && contract.onboardConfirmedAt}}">
      <view class="section-title">上户记录</view>
      <view class="row"><text class="label">确认时间</text><text class="value">{{contract.onboardConfirmedAt}}</text></view>
    </view>

    <!-- 操作按钮区（旧版内联按钮已撤，状态动作统一到底部悬浮条） -->
    <view class="action-area" wx:if="{{false}}"></view>

    <!-- 底部悬浮状态按钮（按当前合同状态自动切换文案） -->
    <view wx:if="{{floatingAction}}" class="floating-action-spacer"></view>
    <view wx:if="{{floatingAction}}" class="floating-action">
      <view class="floating-action-btn floating-action-btn--{{floatingAction.kind}}" bindtap="onFloatingAction">
        {{floatingAction.label}}
      </view>
    </view>
  </block>

  <!-- 单笔只确认一笔金额；只有多笔计划才展示笔次与付款明细。 -->
  <view wx:if="{{paymentConfirm}}" class="payment-confirm-mask" bindtap="cancelPaymentConfirm">
    <view class="payment-confirm-dialog" catchtap="stopPaymentModalTap">
      <view class="payment-confirm-header">
        <view class="payment-confirm-mark">¥</view>
        <view class="payment-confirm-title">确认支付</view>
      </view>
      <view class="payment-confirm-summary">
        <text class="payment-confirm-label">{{paymentConfirm.label}}</text>
        <text class="payment-confirm-amount">¥{{paymentConfirm.amount}}</text>
      </view>

      <view wx:if="{{paymentConfirm.isMultiPaymentPlan}}" class="payment-confirm-stage">
        本次支付第 {{paymentConfirm.sequenceNo}} 笔，共 {{paymentConfirm.totalCount}} 笔
      </view>

      <view wx:if="{{paymentConfirm.isMultiPaymentPlan}}" class="payment-confirm-list">
        <view class="payment-confirm-list-title">付款明细</view>
        <view wx:for="{{paymentConfirm.payments}}" wx:key="sequenceNo" class="payment-confirm-item {{item.sequenceNo === paymentConfirm.sequenceNo ? 'is-current' : ''}}">
          <view>
            <text class="payment-confirm-item-label">{{item.label}}</text>
            <text class="payment-confirm-item-seq">第{{item.sequenceNo}}笔</text>
          </view>
          <text class="payment-confirm-item-amount">¥{{item.amount}}</text>
        </view>
      </view>

      <view wx:elif="{{paymentConfirm.showPaymentItems}}" class="payment-confirm-list">
        <view class="payment-confirm-list-title">费用明细</view>
        <view wx:for="{{paymentConfirm.paymentItems}}" wx:key="index" class="payment-confirm-item">
          <text class="payment-confirm-item-label">{{item.label}}</text>
          <text class="payment-confirm-item-amount">¥{{item.amount}}</text>
        </view>
      </view>

      <view class="payment-confirm-tip">请核对支付金额，确认后将跳转微信支付</view>
      <view class="payment-confirm-actions">
        <view class="payment-confirm-cancel" bindtap="cancelPaymentConfirm">暂不支付</view>
        <view class="payment-confirm-submit" bindtap="confirmPayment">确认支付</view>
      </view>
    </view>
  </view>
</view>

