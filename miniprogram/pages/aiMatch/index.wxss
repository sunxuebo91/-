/* pages/aiMatch/index.wxss */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #5A3DD8 0%, #6A4AE8 220rpx, #7B5BF5 420rpx, #9B7BF8 580rpx, #F5F2FB 720rpx, #F5F2FB 100%);
  box-sizing: border-box;
  overflow-x: hidden;
}

/* ────────────── 自定义导航栏 ────────────── */
.nav-bar {
  position: relative;
  z-index: 10;
  width: 100%;
  background: transparent;
}

.nav-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  position: relative;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.22);
  transition: background 0.2s ease;
}
.nav-back:active { background: rgba(255, 255, 255, 0.4); }

.nav-back-icon {
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 500;
  line-height: 1;
  margin-top: -4rpx;
}

.nav-title {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.nav-placeholder {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

/* ────────────── 输入阶段 ────────────── */
.input-stage {
  padding: 40rpx 32rpx calc(90rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  width: 100%;
  background: transparent;
}

.hero {
  text-align: center;
  margin-bottom: 32rpx;
}
.hero-icon-wrap {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  margin: 6rpx auto 22rpx;
}
/* 呼吸光晕：徽章背后的大范围柔光，明暗起伏营造能量感 */
.hero-glow {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 210rpx;
  height: 210rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.45) 0%, rgba(255,255,255,0.12) 45%, rgba(255,255,255,0) 70%);
  animation: hero-breathe 3.2s ease-in-out infinite;
}
.hero-layer {
  position: absolute;
  left: 0;
  top: 0;
  width: 150rpx;
  height: 150rpx;
}
/* 轨道层：顺时针匀速旋转，候选节点环绕人形 */
.hero-orbit { animation: hero-spin 9s linear infinite; }
/* 雷达扫光：反向慢旋，与轨道形成差速的科技层次 */
.hero-sweep { animation: hero-spin-rev 6s linear infinite; }
/* AI 星芒：定位徽章右上，缩放脉冲 */
.hero-star {
  position: absolute;
  left: 102rpx;
  top: 16rpx;
  width: 40rpx;
  height: 40rpx;
  animation: hero-pulse 2.2s ease-in-out infinite;
}
@keyframes hero-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
@keyframes hero-spin-rev {
  from { transform: rotate(360deg); }
  to { transform: rotate(0deg); }
}
@keyframes hero-pulse {
  0%, 100% { transform: scale(1); opacity: 0.85; }
  50% { transform: scale(1.22); opacity: 1; }
}
@keyframes hero-breathe {
  0%, 100% { opacity: 0.45; }
  50% { opacity: 1; }
}
.hero-title { font-size: 38rpx; font-weight: 700; color: #fff; letter-spacing: 1rpx; text-shadow: 0 2rpx 8rpx rgba(45, 27, 105, 0.4); }
.hero-sub { margin-top: 12rpx; font-size: 24rpx; color: rgba(255,255,255,0.95); text-shadow: 0 1rpx 4rpx rgba(45, 27, 105, 0.3); }

.tips-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.tip-chip {
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.25);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-weight: 500;
}
.tip-chip:active { background: rgba(255, 255, 255, 0.42); }

.input-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(123, 91, 245, 0.18);
}

.input-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #2D1B69;
  margin-bottom: 20rpx;
}

.need-input {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  color: #2D1B69;
  box-sizing: border-box;
  line-height: 1.6;
}
.need-placeholder { color: #B8AED4; }

.input-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F0EAFB;
}

.input-count {
  font-size: 24rpx;
  color: #9B8FC4;
}

.voice-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  background: #F0EAFB;
}
.voice-btn-active { background: #E0D4F7; }
.voice-icon { font-size: 32rpx; color: #7B5BF5; }
.voice-text { font-size: 26rpx; color: #7B5BF5; font-weight: 600; }

.match-btn {
  display: block;
  width: 100% !important;
  margin: 40rpx 0 0 !important;
  padding: 0 !important;
  box-sizing: border-box !important;
  background: linear-gradient(135deg, #7B5BF5 0%, #9B7BF8 100%) !important;
  color: #fff !important;
  font-size: 32rpx;
  font-weight: 700;
  border: none !important;
  border-radius: 999rpx !important;
  height: 96rpx;
  line-height: 96rpx;
  box-shadow: 0 12rpx 28rpx rgba(123, 91, 245, 0.35);
  text-align: center;
}
.match-btn::after { border: none !important; }
.match-btn[disabled] { opacity: 0.6; color: #fff !important; }

.footer-hint {
  text-align: center;
  font-size: 22rpx;
  color: #9B8FC4;
  margin-top: 32rpx;
}
/* 合规声明：固定页面底部（AI 仅提供算法、不生成内容，审核一眼可见） */
.ai-disclaimer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  text-align: center;
  font-size: 22rpx;
  color: #7E6FB0;
  z-index: 5;
}

/* ────────────── 结果阶段：探探骨架 ────────────── */
/* flex 纵向三段：需求摘要行（自然高）→ 卡片区（flex:1 填满）→ 按钮区（自然高贴底） */
.result-stage {
  display: flex;
  flex-direction: column;
  padding: 16rpx 24rpx 0;
  box-sizing: border-box;
}

.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 12rpx 16rpx;
  flex-shrink: 0;
}
.result-summary {
  flex: 1;
  font-size: 24rpx;
  color: rgba(255,255,255,0.95);
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.result-reset {
  font-size: 24rpx;
  color: #fff;
  background: rgba(255,255,255,0.25);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}

/* 结果头部的"已选 N 位"入口：紫色 chip，跳"我的心动阿姨" */
.likes-chip {
  font-size: 24rpx;
  color: #fff;
  background: #7B5BF5;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  margin-right: 12rpx;
  flex-shrink: 0;
}

/* 放宽提示条：没有完全符合条件时的说明，浅紫低调、自然高不遮挡卡片 */
.relax-note {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #5A3DD8;
  background: rgba(245, 242, 251, 0.95);
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  margin: 0 12rpx 12rpx;
  line-height: 1.5;
}
/* 合规声明：结果页整体算法推荐说明，位于摘要行下方（紫色渐变底上用半透明白） */
.ai-result-note {
  flex-shrink: 0;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  padding: 0 12rpx 12rpx;
}

/* 卡片区：flex:1 填满剩余空间，卡片顶到需求摘要行下、按钮区之上，无死空间 */
.card-area {
  position: relative;
  flex: 1;
  min-height: 320px;
  display: flex;
  flex-direction: column;
}

.card-stack {
  position: relative;
  flex: 1;
  min-height: 0;
  width: 100%;
  margin: 0 auto;
  max-width: 700rpx;
}

/* 探探风卡片：圆角 24rpx（不是 32rpx），明显的堆叠纵深；整卡一张照片 */
.swipe-card {
  position: absolute;
  top: 0; left: 12rpx; right: 12rpx;
  height: 100%;
  border-radius: 24rpx;
  overflow: hidden;
  background: #000;
  box-shadow: 0 16rpx 40rpx rgba(45, 27, 105, 0.28);
  will-change: transform;
}

/* 整卡一张照片：背景图 cover + 居中定位（能看到脸和上半身） */
.card-photo {
  width: 100%;
  height: 100%;
  background-size: cover;
  background-position: center center;
  background-repeat: no-repeat;
  background-color: #2D1B69;
}

/* 顶部 chip */
.card-top {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  right: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 2;
}

.card-job-pill {
  font-size: 22rpx;
  color: #fff;
  background: rgba(45, 27, 105, 0.55);
  backdrop-filter: blur(10rpx);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.card-score {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  background: #FFD166;
  color: #2D1B69;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  font-weight: 700;
}
.card-score-icon { font-size: 22rpx; }

/* 诚实匹配：未满足条件小标签，挂在 pill/角标一行下方，琥珀色低调不抢主视觉 */
.card-unmet {
  position: absolute;
  top: 80rpx;
  left: 24rpx;
  right: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  z-index: 2;
}
.card-unmet-tag {
  font-size: 20rpx;
  color: #FFE9A8;
  background: rgba(0, 0, 0, 0.35);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  line-height: 1.4;
  white-space: nowrap;
}

/* 底部信息带：绝对定位 + 短渐变蒙版，只占底部约 1/3，不压脸 */
.card-info {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 35%;
  padding: 64rpx 28rpx 28rpx;
  background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.55) 35%, rgba(0,0,0,0.85) 100%);
  overflow: hidden;
  z-index: 2;
}

.card-name-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  color: #fff;
  flex-wrap: wrap;
  margin-bottom: 10rpx;
}
.card-name {
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.4);
  line-height: 1.2;
}
.card-info-line {
  font-size: 26rpx;
  color: rgba(255,255,255,0.92);
  font-weight: 500;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.4);
}

/* 服务端给的推荐理由：暖金色与角标呼应，限制 1 行省略 */
.card-reason {
  font-size: 24rpx;
  color: #FFE9A8;
  line-height: 1.5;
  margin-bottom: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-shadow: 0 2rpx 6rpx rgba(0,0,0,0.4);
}
/* 合规标识：AI 推荐理由下方的小号半透明胶囊标签（card-info 为块布局，inline-block 自适应宽度） */
.ai-gen-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #FFE9A8;
  background: rgba(255, 233, 168, 0.18);
  border: 1rpx solid rgba(255, 233, 168, 0.35);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  margin: 0 0 8rpx;
  line-height: 1.5;
}

/* 技能标签：最多一行（js 里已 slice(0,3)），不换行、溢出隐藏 */
.card-tags {
  display: flex;
  flex-wrap: nowrap;
  gap: 10rpx;
  margin-bottom: 10rpx;
  max-width: 100%;
  overflow: hidden;
}
.card-tag {
  font-size: 22rpx;
  color: #fff;
  background: rgba(255,255,255,0.18);
  border: 1rpx solid rgba(255,255,255,0.3);
  border-radius: 999rpx;
  padding: 5rpx 14rpx;
  font-weight: 500;
  backdrop-filter: blur(6rpx);
  white-space: nowrap;
  line-height: 1.4;
}

.card-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}
.card-price {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}
.card-price-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #FFD166;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.4);
  line-height: 1;
}
.card-price-unit {
  font-size: 22rpx;
  font-weight: 500;
  color: rgba(255,255,255,0.9);
}
.card-detail {
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
  background: rgba(255,255,255,0.2);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  font-weight: 500;
  backdrop-filter: blur(6rpx);
}

/* 滑动反馈角标 */
.card-badge {
  position: absolute;
  top: 120rpx;
  font-size: 40rpx;
  font-weight: 800;
  padding: 10rpx 28rpx;
  border-radius: 12rpx;
  border: 5rpx solid;
  z-index: 5;
  background: rgba(255,255,255,0.92);
}
.like-badge { left: 50rpx; color: #7B5BF5; border-color: #7B5BF5; transform: rotate(-15deg); }
.nope-badge { right: 50rpx; color: #FF3141; border-color: #FF3141; transform: rotate(15deg); }

.empty-stage {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.empty-icon { font-size: 88rpx; }
.empty-text { margin: 16rpx 0 32rpx; font-size: 28rpx; color: #6B5FA5; }
/* "看完了"空态的上一张入口：低调文字按钮，跟在主按钮下方 */
.empty-undo {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #9B8FC4;
  padding: 8rpx 24rpx;
}
/* "看完了"空态的"查看我的心动阿姨"入口：品牌紫文字链接 */
.empty-likes {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #7B5BF5;
  font-weight: 600;
  padding: 8rpx 24rpx;
}

/* 操作区：三个等大次级圆钮 + 全宽面试 CTA（贴卡片下方，flex-shrink:0 自然高） */
.action-panel {
  flex-shrink: 0;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}

.action-row {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 入场动画：仅在结果页首次进入时播一次（用 resultEntered class 控制） */
@keyframes btnPulse {
  0% { transform: scale(0.6); opacity: 0; }
  60% { transform: scale(1.08); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

/* resultEntered=false 时入场；=true 后不再播 */
.action-panel:not(.entered) .action-icon-circle,
.action-panel:not(.entered) .interview-cta {
  animation: btnPulse 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}
.action-panel.entered .interview-cta {
  animation: none;
}

/* ♥ 呼吸心跳：idle 每 2.4s 一次轻微脉动（只 icon-circle，不联动整行） */
@keyframes heartBeat {
  0%, 100% { transform: scale(1); }
  8% { transform: scale(1.08); }
  16% { transform: scale(1); }
}

/* 三个次级钮：88rpx 马卡龙软糖风——底色区分语义，不要边框，同色系有色投影 */
.action-icon-circle {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
  transition: transform 0.25s cubic-bezier(0.34, 1.8, 0.64, 1), box-shadow 0.18s ease;
}
/* 果冻按压：scale(0.8) + overshoot 回弹 */
.action-btn:active .action-icon-circle {
  transform: scale(0.8);
}

.action-icon-img {
  width: 40rpx;
  height: 40rpx;
}

/* 上一张：奶灰蓝 */
.undo-circle {
  background: #EEF1F8;
  box-shadow: 0 8rpx 20rpx rgba(138, 147, 184, 0.25);
}
/* 略过：奶粉红 */
.dislike-circle {
  background: #FFE9EB;
  box-shadow: 0 8rpx 20rpx rgba(255, 90, 110, 0.28);
}
/* 合适：粉紫 + 呼吸心跳（entered 后由入场动画切到心跳） */
.like-circle {
  background: #F1EAFE;
  box-shadow: 0 8rpx 20rpx rgba(123, 91, 245, 0.30);
  animation: heartBeat 2.4s ease-in-out infinite;
}
/* 心跳动画会覆盖 transform，按压反馈改用收影 */
.like-btn:active .like-circle {
  box-shadow: 0 2rpx 8rpx rgba(123, 91, 245, 0.20);
}

.action-label {
  font-size: 24rpx;
  font-weight: 500;
}
.undo-label { color: #8A93B8; }
.dislike-label { color: #FF5A6E; }
.like-label { color: #7B5BF5; }

/* 面试 CTA：全宽橙色胶囊主按钮（变现入口） */
.interview-cta {
  margin-top: 28rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FFB24F 0%, #FF8F1F 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.interview-cta:active { opacity: 0.88; }
.interview-cta-icon {
  width: 40rpx;
  height: 40rpx;
}
.interview-cta-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}
