/* pages/aiMatch/index.wxss */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #5A3DD8 0%, #6A4AE8 220rpx, #7B5BF5 420rpx, #9B7BF8 580rpx, #F5F2FB 720rpx, #F5F2FB 100%);
  padding-bottom: 60rpx;
  box-sizing: border-box;
  overflow-x: hidden;
}

/* ────────────── 自定义导航栏 ────────────── */
.nav-bar {
  position: relative;
  z-index: 10;
  width: 100%;
  background: transparent;
}

.nav-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  position: relative;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.22);
  transition: background 0.2s ease;
}
.nav-back:active { background: rgba(255, 255, 255, 0.4); }

.nav-back-icon {
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 500;
  line-height: 1;
  margin-top: -4rpx;
}

.nav-title {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.nav-placeholder {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

/* ────────────── 输入阶段 ────────────── */
.input-stage {
  padding: 40rpx 32rpx 40rpx;
  box-sizing: border-box;
  width: 100%;
  background: transparent;
}

.hero {
  text-align: center;
  margin-bottom: 32rpx;
}
.hero-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.28);
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
}
.hero-icon { font-size: 64rpx; line-height: 1; }
.hero-title { font-size: 38rpx; font-weight: 700; color: #fff; letter-spacing: 1rpx; text-shadow: 0 2rpx 8rpx rgba(45, 27, 105, 0.4); }
.hero-sub { margin-top: 12rpx; font-size: 24rpx; color: rgba(255,255,255,0.95); text-shadow: 0 1rpx 4rpx rgba(45, 27, 105, 0.3); }

.tips-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.tip-chip {
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.25);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.input-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(123, 91, 245, 0.18);
}

.input-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #2D1B69;
  margin-bottom: 20rpx;
}

.need-input {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  color: #2D1B69;
  box-sizing: border-box;
  line-height: 1.6;
}
.need-placeholder { color: #B8AED4; }

.input-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F0EAFB;
}

.input-count {
  font-size: 24rpx;
  color: #9B8FC4;
}

.voice-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  background: #F0EAFB;
}
.voice-btn-active { background: #E0D4F7; }
.voice-icon { font-size: 32rpx; color: #7B5BF5; }
.voice-text { font-size: 26rpx; color: #7B5BF5; font-weight: 600; }

.match-btn {
  display: block;
  width: 100% !important;
  margin: 40rpx 0 0 !important;
  padding: 0 !important;
  box-sizing: border-box !important;
  background: linear-gradient(135deg, #7B5BF5 0%, #9B7BF8 100%) !important;
  color: #fff !important;
  font-size: 32rpx;
  font-weight: 700;
  border: none !important;
  border-radius: 999rpx !important;
  height: 96rpx;
  line-height: 96rpx;
  box-shadow: 0 12rpx 28rpx rgba(123, 91, 245, 0.35);
  text-align: center;
}
.match-btn::after { border: none !important; }
.match-btn[disabled] { opacity: 0.6; color: #fff !important; }

.footer-hint {
  text-align: center;
  font-size: 22rpx;
  color: #9B8FC4;
  margin-top: 32rpx;
}

/* ────────────── 结果阶段：探探骨架 ────────────── */
.result-stage {
  padding: 16rpx 24rpx 0;
}

.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 12rpx 16rpx;
}
.result-summary {
  flex: 1;
  font-size: 24rpx;
  color: rgba(255,255,255,0.95);
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.result-reset {
  font-size: 24rpx;
  color: #fff;
  background: rgba(255,255,255,0.25);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}

/* 卡片区：留出底部 200rpx 给按钮，按钮浮在卡片下方 */
.card-area {
  position: relative;
  padding-bottom: 220rpx;
}

.card-stack {
  position: relative;
  height: 980rpx;
  margin: 0 auto;
  max-width: 700rpx;
}

/* 探探风卡片：圆角 24px（不是 32px），明显的堆叠纵深 */
.swipe-card {
  position: absolute;
  top: 0; left: 12rpx; right: 12rpx;
  height: 980rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #000;
  box-shadow: 0 16rpx 40rpx rgba(45, 27, 105, 0.28);
  will-change: transform;
}

/* 整张卡 = 一张图 */
.card-photo {
  width: 100%;
  height: 100%;
  display: block;
}

/* 顶部 chip */
.card-top {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  right: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 2;
}

.card-job-pill {
  font-size: 22rpx;
  color: #fff;
  background: rgba(45, 27, 105, 0.55);
  backdrop-filter: blur(10rpx);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.card-score {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  background: #FFD166;
  color: #2D1B69;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  font-weight: 700;
}
.card-score-icon { font-size: 22rpx; }

/* 底部信息浮层：黑色渐变 + 内容（探探感的"水印"） */
.card-bottom {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 60rpx 32rpx 32rpx;
  background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.75) 60%, rgba(0,0,0,0.88) 100%);
  z-index: 2;
}

.card-name-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  color: #fff;
  flex-wrap: wrap;
  margin-bottom: 14rpx;
}
.card-name {
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.4);
  line-height: 1.2;
}
.card-info-line {
  font-size: 26rpx;
  color: rgba(255,255,255,0.92);
  font-weight: 500;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.4);
}

.card-intro {
  font-size: 26rpx;
  color: rgba(255,255,255,0.92);
  line-height: 1.55;
  margin-bottom: 16rpx;
  font-style: italic;
  text-shadow: 0 2rpx 6rpx rgba(0,0,0,0.4);
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 14rpx;
  max-width: 100%;
}
.card-tag {
  font-size: 22rpx;
  color: #fff;
  background: rgba(255,255,255,0.18);
  border: 1rpx solid rgba(255,255,255,0.3);
  border-radius: 999rpx;
  padding: 5rpx 14rpx;
  font-weight: 500;
  backdrop-filter: blur(6rpx);
  white-space: nowrap;
  line-height: 1.4;
}

.card-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}
.card-price {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}
.card-price-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #FFD166;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.4);
  line-height: 1;
}
.card-price-unit {
  font-size: 22rpx;
  font-weight: 500;
  color: rgba(255,255,255,0.9);
}
.card-detail {
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
  background: rgba(255,255,255,0.2);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  font-weight: 500;
  backdrop-filter: blur(6rpx);
}

/* 滑动反馈角标 */
.card-badge {
  position: absolute;
  top: 120rpx;
  font-size: 40rpx;
  font-weight: 800;
  padding: 10rpx 28rpx;
  border-radius: 12rpx;
  border: 5rpx solid;
  z-index: 5;
  background: rgba(255,255,255,0.92);
}
.like-badge { left: 50rpx; color: #7B5BF5; border-color: #7B5BF5; transform: rotate(-15deg); }
.nope-badge { right: 50rpx; color: #FF3141; border-color: #FF3141; transform: rotate(15deg); }

.empty-stage {
  height: 600rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.empty-icon { font-size: 88rpx; }
.empty-text { margin: 16rpx 0 32rpx; font-size: 28rpx; color: #6B5FA5; }

/* 4 个按钮：浮在卡片底部，圆形胶囊（探探风格） */
.action-row {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 24rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.action-btn:active { transform: scale(0.88); }

/* 入场动画：仅在结果页首次进入时播一次（用 resultEntered class 控制） */
@keyframes btnPulse {
  0% { transform: scale(0.6); opacity: 0; }
  60% { transform: scale(1.08); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

/* resultEntered=false 时入场；=true 后不再播 */
.action-row:not(.entered) .action-icon-circle {
  animation: btnPulse 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}
.action-row.entered .action-icon-circle {
  animation: none;
}

.action-icon-circle {
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(45, 27, 105, 0.22);
  margin-bottom: 8rpx;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}
.action-btn:active .action-icon-circle {
  transform: scale(0.92);
  box-shadow: 0 4rpx 12rpx rgba(45, 27, 105, 0.18);
}

.action-icon {
  font-weight: 700;
  color: #6B5FA5;
  transition: transform 0.18s ease;
}

/* 4 个按钮的尺寸 + 颜色（按你的需求：
   撤销(灰小) → 略过(红中) → 合适(紫大) → 面试(橙大主推)） */

/* 撤销 ↺：灰小，弱化 */
.undo-btn .action-icon-circle {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 0;
  animation-delay: 0.15s;
}
.undo-btn .action-icon { font-size: 40rpx; color: #B8AED4; line-height: 1; }
.undo-circle { border: 2rpx solid #E5DEF7; background: #fff; }

/* 略过 ✕：红色，中等（"否定"语义） */
.dislike-btn .action-icon-circle {
  width: 108rpx;
  height: 108rpx;
  animation-delay: 0.05s;
}
.dislike-btn .action-icon {
  font-size: 48rpx;
  color: #FF3141;
  line-height: 1;
}
.dislike-circle {
  border: 3rpx solid #FFD9DC;
  box-shadow: 0 8rpx 24rpx rgba(255, 49, 65, 0.22);
  background: #fff;
}

/* 合适 ♥：紫色，最大（"肯定"语义 + 跳详情） */
.like-btn .action-icon-circle {
  width: 128rpx;
  height: 128rpx;
  animation-delay: 0.1s;
}
.like-btn .action-icon {
  font-size: 64rpx;
  color: #7B5BF5;
  line-height: 1;
}
.like-circle {
  border: 4rpx solid #7B5BF5;
  box-shadow: 0 12rpx 32rpx rgba(123, 91, 245, 0.35);
  background: linear-gradient(135deg, #fff 0%, #F5F2FB 100%);
}

/* 面试 ★：橙色高亮，主推（变现入口） */
.super-btn .action-icon-circle {
  width: 128rpx;
  height: 128rpx;
  animation-delay: 0.2s;
}
.super-btn .action-icon {
  font-size: 64rpx;
  color: #fff;
  line-height: 1;
}
.super-circle {
  border: 4rpx solid #FF8F1F;
  background: linear-gradient(135deg, #FFB24F 0%, #FF8F1F 100%);
  box-shadow: 0 12rpx 32rpx rgba(255, 143, 31, 0.4);
}

.action-label {
  font-size: 24rpx;
  color: #6B5FA5;
  font-weight: 500;
  margin-top: 6rpx;
}
.super-btn .action-label { color: #FF8F1F; font-weight: 600; }
