/* pages/aiMatch/index.wxss */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #8766F3 0%, #8766F3 460rpx, #F6F6F6 600rpx, #F6F6F6 100%);
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* ────────────── 自定义导航栏 ────────────── */
.nav-bar {
  position: relative;
  z-index: 10;
  width: 100%;
  background: transparent;
}

.nav-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  position: relative;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.16);
  transition: background 0.2s ease;
}
.nav-back:active { background: rgba(255, 255, 255, 0.3); }

.nav-back-icon {
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 500;
  line-height: 1;
  margin-top: -4rpx;
}

.nav-title {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.nav-placeholder {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

/* ────────────── 输入阶段 ────────────── */
.input-stage {
  padding: 40rpx 32rpx 40rpx;
}

.hero {
  text-align: center;
  margin-bottom: 32rpx;
}
.hero-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
}
.hero-icon { font-size: 64rpx; line-height: 1; }
.hero-title { font-size: 36rpx; font-weight: 800; color: #fff; }
.hero-sub { margin-top: 12rpx; font-size: 24rpx; color: rgba(255,255,255,0.85); }

.tips-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.tip-chip {
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.15);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.input-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(135, 102, 243, 0.12);
}

.input-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 20rpx;
}

.need-input {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  line-height: 1.6;
}
.need-placeholder { color: #b3b3b3; }

.input-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f5f5f5;
}

.input-count {
  font-size: 24rpx;
  color: #999;
}

.voice-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  background: #F4F0FF;
}
.voice-btn-active { background: #EAE2FF; }
.voice-icon { font-size: 32rpx; color: #8766F3; }
.voice-text { font-size: 26rpx; color: #8766F3; font-weight: 600; }

.match-btn {
  display: block;
  width: 100% !important;
  margin: 40rpx 0 0 !important;
  padding: 0 !important;
  box-sizing: border-box !important;
  background: #8766F3 !important;
  color: #fff !important;
  font-size: 32rpx;
  font-weight: 700;
  border: none !important;
  border-radius: 999rpx !important;
  height: 96rpx;
  line-height: 96rpx;
  box-shadow: 0 12rpx 28rpx rgba(135, 102, 243, 0.25);
  text-align: center;
}
.match-btn::after {
  border: none !important;
}
.match-btn[disabled] {
  opacity: 0.6;
  color: #fff !important;
}

.footer-hint {
  text-align: center;
  font-size: 22rpx;
  color: #999;
  margin-top: 32rpx;
}

/* ────────────── 结果阶段（探探式滑动） ────────────── */
.result-stage {
  padding: 24rpx 24rpx 0;
}

.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 12rpx;
}
.result-summary {
  flex: 1;
  font-size: 24rpx;
  color: rgba(255,255,255,0.95);
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.result-reset {
  font-size: 24rpx;
  color: #fff;
  background: rgba(255,255,255,0.2);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}

.card-stack {
  position: relative;
  height: 920rpx;
  margin-top: 12rpx;
}

.swipe-card {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 920rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 20rpx 50rpx rgba(45, 27, 105, 0.25);
  will-change: transform;
}

.card-photo {
  width: 100%;
  height: 100%;
}

.card-badge {
  position: absolute;
  top: 60rpx;
  font-size: 36rpx;
  font-weight: 800;
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  border: 4rpx solid;
  transform: rotate(-15deg);
}
.like-badge { left: 40rpx; color: #8766F3; border-color: #8766F3; }
.nope-badge { right: 40rpx; color: #999; border-color: #999; transform: rotate(15deg); }

.card-info-mask {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  padding: 32rpx 32rpx 40rpx;
  background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.85) 100%);
}

.card-top-row { display: flex; align-items: center; gap: 14rpx; }
.card-name { font-size: 38rpx; font-weight: 800; color: #fff; }
.card-job-tag {
  font-size: 20rpx;
  color: #fff;
  background: rgba(255,255,255,0.25);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}
.card-info-line { margin-top: 8rpx; font-size: 24rpx; color: rgba(255,255,255,0.9); }

.card-tags { margin-top: 12rpx; display: flex; flex-wrap: wrap; gap: 10rpx; }
.card-tag {
  font-size: 20rpx;
  color: #fff;
  background: rgba(108, 92, 231, 0.55);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.card-price { margin-top: 14rpx; font-size: 32rpx; font-weight: 800; color: #FFD166; }
.card-price-unit { font-size: 20rpx; font-weight: 400; margin-left: 4rpx; }

.empty-stage {
  height: 920rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.empty-icon { font-size: 88rpx; }
.empty-text { margin: 16rpx 0 32rpx; font-size: 28rpx; color: #666; }

.action-row {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  gap: 80rpx;
  margin-top: 40rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.action-btn:active { transform: scale(0.92); }
.action-icon {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.action-label {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.dislike-btn .action-icon { color: #999; font-size: 36rpx; }
.like-btn .action-icon { color: #8766F3; font-size: 44rpx; border: 4rpx solid #8766F3; }
.detail-btn .action-icon { width: 88rpx; height: 88rpx; font-size: 28rpx; color: #333; }