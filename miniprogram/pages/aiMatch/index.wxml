<!--pages/aiMatch/index.wxml-->
<view class="page">

  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar-inner" style="height: {{navBarHeight}}px;">
      <view class="nav-back" bindtap="onNavBack">
        <text class="nav-back-icon">‹</text>
      </view>
      <view class="nav-title">AI 智能匹配</view>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <!-- 输入阶段：文字+语音输入需求 -->
  <view class="input-stage" wx:if="{{!resultReady}}">
    <view class="hero">
      <view class="hero-icon-wrap">
        <text class="hero-icon">✨</text>
      </view>
      <view class="hero-title">AI 智能匹配</view>
      <view class="hero-sub">描述您的家政需求，智能为您推荐合适的服务人员</view>
    </view>

    <view class="tips-row">
      <view class="tip-chip">月嫂</view>
      <view class="tip-chip">育儿嫂</view>
      <view class="tip-chip">保姆</view>
      <view class="tip-chip">护老</view>
    </view>

    <view class="input-card">
      <view class="input-label">需求描述</view>
      <textarea
        class="need-input"
        placeholder="例如：想找一位山东籍、擅长辅食制作的月嫂，预算 8000 元以内，最好有新生儿护理经验"
        placeholder-class="need-placeholder"
        value="{{inputText}}"
        bindinput="onInputText"
        maxlength="300"
        auto-height
      ></textarea>

      <view class="input-toolbar">
        <view class="input-count">{{inputText.length || 0}}/300</view>
        <view
          class="voice-btn {{recording ? 'voice-btn-active' : ''}}"
          bindtouchstart="onVoiceStart"
          bindtouchend="onVoiceEnd"
        >
          <text class="voice-icon">{{recording ? '⏹' : '🎙'}}</text>
          <text class="voice-text">{{recording ? '松开结束' : '按住说话'}}</text>
        </view>
      </view>
    </view>

    <button class="match-btn" bindtap="matchNow" loading="{{matching}}" disabled="{{matching}}">
      {{matching ? '正在智能匹配...' : '开始智能匹配'}}
    </button>

    <view class="footer-hint">支持语音/文字 · 按匹配度推荐 · 左右滑动查看</view>
  </view>

  <!-- 结果阶段：探探骨架 + 家政血肉 -->
  <view class="result-stage" wx:if="{{resultReady}}">
    <view class="result-header">
      <view class="result-summary">{{needs.summary || inputText}}</view>
      <view class="result-reset" bindtap="resetMatch">重新描述</view>
    </view>

    <view class="card-area">
      <view class="card-stack" wx:if="{{currentIndex < cards.length}}">
        <view
          wx:for="{{stackCards}}"
          wx:key="_id"
          wx:for-index="idx"
          class="swipe-card"
          data-index="{{idx}}"
          data-id="{{item._id}}"
          style="{{idx === 0 ? cardStyle : item.stackStyle}}"
          bindtouchstart="onTouchStart"
          bindtouchmove="onTouchMove"
          bindtouchend="onTouchEnd"
          catchtap="tapDetail"
        >
          <!-- 整张卡 = 一张图 -->
          <image class="card-photo" src="{{item.coverFileId || '/images/default-goods-image.png'}}" mode="aspectFill"></image>

          <!-- 顶部：岗位 + 评分 -->
          <view class="card-top">
            <view class="card-job-pill" wx:if="{{item.jobTypeLabel}}">{{item.jobTypeLabel}}</view>
            <view class="card-score" wx:if="{{item.score}}">
              <text class="card-score-icon">★</text>
              <text>{{item.score}}</text>
            </view>
          </view>

          <!-- 底部：黑色渐变 + 信息浮层（名字/年龄/价格/自我描述/技能） -->
          <view class="card-bottom">
            <view class="card-name-row">
              <text class="card-name">{{item.name}}</text>
              <text class="card-info-line" wx:if="{{item.infoLine}}">· {{item.infoLine}}</text>
            </view>

            <view class="card-intro" wx:if="{{item.intro}}">"{{item.intro}}"</view>

            <view class="card-tags" wx:if="{{item.tags && item.tags.length}}">
              <text class="card-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
            </view>

            <view class="card-price-row">
              <view class="card-price">
                <text class="card-price-num">¥{{item.priceMonth}}</text>
                <text class="card-price-unit">{{item.priceUnit}}</text>
              </view>
              <view class="card-detail" catchtap="tapDetail">详情 ›</view>
            </view>
          </view>

          <!-- 滑动反馈角标 -->
          <view class="card-badge like-badge" wx:if="{{idx === 0 && swipeDirection === 'like'}}">合适</view>
          <view class="card-badge nope-badge" wx:if="{{idx === 0 && swipeDirection === 'nope'}}">略过</view>
        </view>
      </view>

      <view class="empty-stage" wx:else>
        <text class="empty-icon">✨</text>
        <view class="empty-text">已经看完全部推荐啦</view>
        <button class="match-btn" bindtap="resetMatch">重新提需求</button>
      </view>

      <!-- 4 个圆形按钮，浮在卡片底部之上 -->
      <view class="action-row {{resultEntered ? 'entered' : ''}}" wx:if="{{currentIndex < cards.length}}">
        <view class="action-btn undo-btn" bindtap="tapUndo">
          <view class="action-icon-circle undo-circle">
            <text class="action-icon">↺</text>
          </view>
        </view>
        <view class="action-btn dislike-btn" bindtap="tapDislike">
          <view class="action-icon-circle dislike-circle">
            <text class="action-icon">✕</text>
          </view>
          <text class="action-label">略过</text>
        </view>
        <view class="action-btn like-btn" bindtap="tapLike">
          <view class="action-icon-circle like-circle">
            <text class="action-icon">♥</text>
          </view>
          <text class="action-label">合适</text>
        </view>
        <view class="action-btn super-btn" bindtap="tapSuper">
          <view class="action-icon-circle super-circle">
            <text class="action-icon">★</text>
          </view>
          <text class="action-label">面试</text>
        </view>
      </view>
    </view>
  </view>
</view>
