<!--pages/aiMatch/index.wxml-->
<view class="page">

  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar-inner" style="height: {{navBarHeight}}px;">
      <view class="nav-back" bindtap="onNavBack">
        <text class="nav-back-icon">‹</text>
      </view>
      <view class="nav-title">AI 智能匹配</view>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <!-- 输入阶段：文字+语音输入需求 -->
  <view class="input-stage" wx:if="{{!resultReady}}">
    <view class="hero">
      <view class="hero-icon-wrap">
        <image class="hero-icon-img" src="data:image/svg+xml;base64," mode="aspectFit"/>
      </view>
      <view class="hero-title">说出需求，AI 帮你挑阿姨</view>
      <view class="hero-sub">描述您的家政需求，智能为您推荐合适的服务人员</view>
    </view>

    <view class="tips-row">
      <view class="tip-chip" data-text="想找一位月嫂，预算 15000 以内，有新生儿护理经验" bindtap="tapTipChip">月嫂</view>
      <view class="tip-chip" data-text="想找一位住家育儿嫂，擅长早教和辅食，带 1 岁宝宝" bindtap="tapTipChip">育儿嫂</view>
      <view class="tip-chip" data-text="想找一位住家保姆，做饭好吃，会整理收纳" bindtap="tapTipChip">保姆</view>
      <view class="tip-chip" data-text="想找一位住家护老阿姨，照顾半自理老人，有耐心" bindtap="tapTipChip">护老</view>
    </view>

    <view class="input-card">
      <view class="input-label">需求描述</view>
      <textarea
        class="need-input"
        placeholder="例如：想找一位山东籍、擅长辅食制作的月嫂，预算 8000 元以内，最好有新生儿护理经验"
        placeholder-class="need-placeholder"
        value="{{inputText}}"
        bindinput="onInputText"
        maxlength="300"
        auto-height
      ></textarea>

      <view class="input-toolbar">
        <view class="input-count">{{inputText.length || 0}}/300</view>
        <view
          class="voice-btn {{recording ? 'voice-btn-active' : ''}}"
          bindtouchstart="onVoiceStart"
          bindtouchend="onVoiceEnd"
          bindtouchcancel="onVoiceEnd"
        >
          <text class="voice-icon">{{recording ? '⏹' : '🎙'}}</text>
          <text class="voice-text">{{recording ? '松开结束 ' + recordSeconds + 's' : '按住说话'}}</text>
        </view>
      </view>
    </view>

    <button class="match-btn" bindtap="matchNow" loading="{{matching}}" disabled="{{matching}}">
      {{matching ? '正在智能匹配...' : '开始智能匹配'}}
    </button>

    <view class="footer-hint">支持语音/文字 · 按匹配度推荐 · 左右滑动查看</view>
    <!-- 合规声明：AI 仅提供算法、不生成内容；固定页面底部，审核一眼可见 -->
    <view class="ai-disclaimer">AI 仅提供匹配算法，不生成任何内容，算法结果仅供参考</view>
  </view>

  <!-- 结果阶段：探探骨架 + 家政血肉；flex 纵向撑满视口剩余高度 -->
  <view class="result-stage" wx:if="{{resultReady}}" style="height: calc(100vh - {{statusBarHeight}}px - {{navBarHeight}}px);">
    <view class="result-header">
      <view class="result-summary">{{needs.summary || inputText}}</view>
      <view class="likes-chip" bindtap="goMyLikes">已选 {{likeCount}} 位 ›</view>
      <view class="result-reset" bindtap="resetMatch">重新描述</view>
    </view>

    <!-- 合规声明：结果页整体算法推荐说明 -->
    <view class="ai-result-note">推荐结果由匹配算法计算得出，仅供参考，实际服务以顾问沟通为准</view>

    <!-- 放宽提示条：没有完全符合条件的阿姨时后端给的说明（strictCount=0 才有） -->
    <view class="relax-note" wx:if="{{relaxNote}}">💡 {{relaxNote}}</view>

    <view class="card-area">
      <view class="card-stack" wx:if="{{currentIndex < cards.length}}">
        <view
          wx:for="{{stackCards}}"
          wx:key="_id"
          wx:for-index="idx"
          class="swipe-card"
          data-index="{{idx}}"
          data-id="{{item._id}}"
          style="{{idx === 0 ? cardStyle : item.stackStyle}}"
          bindtouchstart="onTouchStart"
          bindtouchmove="onTouchMove"
          bindtouchend="onTouchEnd"
          catchtap="tapDetail"
        >
          <!-- 上部照片区：view 背景图，center 20% 偏上定位，人脸（一般在画面上 1/3 处）不被信息区顶掉 -->
          <view class="card-photo" style="background-image: url({{item.coverFileId || '/images/default-goods-image.png'}})"></view>

          <!-- 顶部：岗位 + 评分（绝对定位于照片区顶部，不压脸） -->
          <view class="card-top">
            <view class="card-job-pill" wx:if="{{item.jobTypeLabel}}">{{item.jobTypeLabel}}</view>
            <view class="card-score" wx:if="{{item.matchScore}}">匹配度 {{item.matchScore}}%</view>
          </view>

          <!-- 诚实匹配：未满足条件小标签（琥珀色低调，无则整个不渲染） -->
          <view class="card-unmet" wx:if="{{item.unmetLabels && item.unmetLabels.length}}">
            <text class="card-unmet-tag" wx:for="{{item.unmetLabels}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
          </view>

          <!-- 下部信息区：实心深底，正常文档流（名字/推荐理由/自我描述/技能/价格） -->
          <view class="card-info">
            <view class="card-name-row">
              <text class="card-name">{{item.name}}</text>
              <text class="card-info-line" wx:if="{{item.infoLine}}">· {{item.infoLine}}</text>
            </view>

            <view class="card-reason" wx:if="{{item.matchReason}}">{{item.matchReason}}</view>
            <!-- 合规标识：AI 推荐理由旁的算法推荐胶囊标签 -->
            <view class="ai-gen-tag" wx:if="{{item.matchReason}}">算法推荐</view>

            <view class="card-tags" wx:if="{{item.tags && item.tags.length}}">
              <text class="card-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
            </view>

            <view class="card-price-row">
              <view class="card-price">
                <text class="card-price-num">¥{{item.priceMonth}}</text>
                <text class="card-price-unit">{{item.priceUnit}}</text>
              </view>
              <view class="card-detail" catchtap="tapDetail">详情 ›</view>
            </view>
          </view>

          <!-- 滑动反馈角标 -->
          <view class="card-badge like-badge" wx:if="{{idx === 0 && swipeDirection === 'like'}}">合适</view>
          <view class="card-badge nope-badge" wx:if="{{idx === 0 && swipeDirection === 'nope'}}">略过</view>
        </view>
      </view>

      <view class="empty-stage" wx:else>
        <text class="empty-icon">✨</text>
        <!-- 空态分离：没匹配到 vs 看完了全部推荐 -->
        <block wx:if="{{emptyReason === 'no-match'}}">
          <view class="empty-text">暂无完全匹配的阿姨，换个说法试试</view>
          <button class="match-btn" bindtap="resetMatch">重新描述</button>
        </block>
        <block wx:else>
          <view class="empty-text">已经看完全部推荐啦</view>
          <button class="match-btn" bindtap="resetMatch">重新提需求</button>
          <view class="empty-undo" bindtap="tapUndo">上一张</view>
          <view class="empty-likes" bindtap="goMyLikes">查看我的心动阿姨 ›</view>
        </block>
      </view>

      <!-- 操作区：三个等大次级圆钮（同一基线）+ 全宽面试 CTA -->
      <view class="action-panel {{resultEntered ? 'entered' : ''}}" wx:if="{{currentIndex < cards.length}}">
        <view class="action-row">
          <view class="action-btn" bindtap="tapUndo">
            <view class="action-icon-circle undo-circle">
              <image class="action-icon-img" src="{{iconUndo}}" mode="aspectFit"></image>
            </view>
            <text class="action-label undo-label">上一张</text>
          </view>
          <view class="action-btn" bindtap="tapDislike">
            <view class="action-icon-circle dislike-circle">
              <image class="action-icon-img" src="{{iconNope}}" mode="aspectFit"></image>
            </view>
            <text class="action-label dislike-label">略过</text>
          </view>
          <view class="action-btn" bindtap="tapLike">
            <view class="action-icon-circle like-circle">
              <image class="action-icon-img" src="{{iconLike}}" mode="aspectFit"></image>
            </view>
            <text class="action-label like-label">合适</text>
          </view>
        </view>
        <view class="interview-cta" bindtap="tapSuper">
          <image class="interview-cta-icon" src="{{iconStar}}" mode="aspectFit"></image>
          <text class="interview-cta-text">申请面试</text>
        </view>
      </view>
    </view>
  </view>
</view>
