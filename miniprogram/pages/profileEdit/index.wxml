<view class="page">
  <view class="section">
    <view class="section-title">头像</view>
    <view class="info-item">
      <view class="value-wrapper">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" hover-class="avatar-btn-hover">
          <image class="avatar" src="{{tempAvatarUrl || '/images/icons_v2/avatar.png'}}"></image>
          <view class="edit-text">点击更换</view>
        </button>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">昵称</view>
    <view class="info-item">
      <view class="value-wrapper">
        <input
          class="nickname-input"
          type="nickname"
          placeholder="选填，不填也能用"
          value="{{tempNickname}}"
          bindinput="onNicknameInput"
          bindblur="onNicknameBlur"
        />
      </view>
    </view>
  </view>

  <view class="btn-wrapper">
    <button class="save-btn" bindtap="onSave">保存修改</button>
  </view>
</view>
