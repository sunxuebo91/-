page {
  background: #EDE8FD;
}

.transparent-service {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 板块容器 */
.section {
  margin: 24rpx 20rpx 8rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx 16rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 板块标题 */
.section-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 4rpx 0 16rpx;
  border-bottom: 1rpx dashed #ececf2;
  margin-bottom: 16rpx;
}

.section-emoji {
  display: none; /* 隐藏原生emoji，使用左侧小色块替代 */
}

.section-head::before {
  content: '';
  width: 8rpx;
  height: 32rpx;
  background: #8766F3;
  border-radius: 4rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #2c2c2c;
  letter-spacing: 1rpx;
  line-height: 1;
}

.section-sub {
  font-size: 22rpx;
  color: #999;
  margin-left: auto;
  letter-spacing: 1rpx;
}

/* 内容区域:3个一行,超出换行 */
.content {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

/* 报价卡片通用样式：正方形，4个一行 */
.price-card {
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: 20rpx;
  background: #fdfcff;
  border: 1rpx solid rgba(135, 102, 243, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(135, 102, 243, 0.05);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.price-card:active {
  transform: translateY(2rpx) scale(0.97);
  box-shadow: 0 2rpx 6rpx rgba(135, 102, 243, 0.04);
}

.price-card-image {
  width: 88rpx;
  height: 88rpx;
  object-fit: contain;
}

.price-card-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #333333;
  text-align: center;
  padding: 0 8rpx;
}

