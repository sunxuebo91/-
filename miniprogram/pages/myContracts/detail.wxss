.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 48rpx;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding-top: 200rpx;
}
.loading-text {
  font-size: 30rpx;
  color: #999;
}

.login-expired-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}
.login-expired-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.login-expired-text { font-size: 32rpx; color: #555; font-weight: 500; }
.login-expired-sub { font-size: 26rpx; color: #999; margin-top: 12rpx; }
.relogin-btn {
  margin-top: 40rpx;
  padding: 20rpx 60rpx;
  background: linear-gradient(135deg, #8766F3 0%, #A694FF 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  box-shadow: 0 6rpx 20rpx rgba(135, 102, 243, 0.3);
}

/* 状态横幅 */
.status-banner {
  padding: 40rpx 32rpx;
  text-align: center;
}
.status-banner.status-draft,
.status-banner.status-signing { background: linear-gradient(135deg, #A694FF 0%, #8766F3 100%); }
.status-banner.status-signed { background: linear-gradient(135deg, #8766F3 0%, #6B4FC7 100%); }
.status-banner.status-active { background: linear-gradient(135deg, #8766F3 0%, #4B2DBA 100%); }
.status-banner.status-ended,
.status-banner.status-cancelled,
.status-banner.status-replaced { background: linear-gradient(135deg, #b0b0b0 0%, #909090 100%); }
.status-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.status-kind-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-weight: 500;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
}
.status-kind-tag-housekeeping { background: rgba(135, 102, 243, 0.85); }
.status-kind-tag-training { background: rgba(78, 205, 196, 0.85); }

.value-mono {
  font-family: 'Consolas', 'Monaco', monospace;
  font-size: 24rpx;
}

/* 区块 */
.section {
  background: #fff;
  margin: 24rpx;
  padding: 32rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #8766F3;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #8766F3;
}

.row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.row:last-child { margin-bottom: 0; }
.label {
  font-size: 26rpx;
  color: #999;
  width: 140rpx;
  flex-shrink: 0;
}
.value {
  font-size: 28rpx;
  color: #333;
}
.value-row {
  display: flex;
  align-items: center;
  flex: 1;
  gap: 16rpx;
}

.call-btn {
  font-size: 24rpx;
  color: #fff;
  background: #8766F3;
  border-radius: 20rpx;
  padding: 6rpx 24rpx;
}

/* 签约进度 */
.signer-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.signer-row:last-child { border-bottom: none; }
.signer-label {
  font-size: 28rpx;
  color: #555;
}
.signer-status {
  font-size: 26rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}
.signer-status.done { background: #f0ecfd; color: #8766F3; }
.signer-status.signing { background: #fff3e0; color: #ff9800; }
.signer-status.pending { background: #f5f5f5; color: #999; }

/* 签署卡片（圆角） */
.signer-card {
  background: #faf8ff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  min-height: 130rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}
.signer-card:last-of-type { margin-bottom: 0; }
.signer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 48rpx;
  gap: 16rpx;
}
.signer-label {
  font-size: 28rpx;
  color: #555;
  line-height: 40rpx;
  flex: 1;
}
.signer-badge {
  min-width: 132rpx;
  height: 40rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 16rpx;
}
.signer-badge__text {
  font-size: 24rpx;
  line-height: 1;
  display: block;
}
.signer-badge.done { background: #f0ecfd; color: #8766F3; }
.signer-badge.signing { background: #fff3e0; color: #ff9800; }
.signer-badge.pending { background: #f5f5f5; color: #999; }
.signer-meta {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
}
.mono {
  font-family: 'Consolas', 'Monaco', monospace;
  font-size: 24rpx;
  color: #555;
}

.sign-action-spacer {
  height: 160rpx;
}

.sign-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 99;
}
.sign-action-btn {
  background: linear-gradient(135deg, #8766F3 0%, #6B4FC7 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border-radius: 48rpx;
  box-shadow: 0 6rpx 20rpx rgba(135, 102, 243, 0.35);
  text-align: center;
  flex: 1;
  margin: 0;
  line-height: 1;
  border: none;
}
.sign-action-btn::after {
  border: none;
}
.sign-action-btn--secondary {
  background: #fff;
  color: #8766F3;
  border: 2rpx solid #8766F3;
  box-shadow: none;
}

/* 收款配置 */
.value-amount {
  font-size: 32rpx;
  color: #ff6b35;
  font-weight: 700;
}
.status-mini {
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
}
.status-mini.paid,
.status-mini.unpaid { background: #f0ecfd; color: #8766F3; }
.status-mini.partial { background: #fff3e0; color: #ff9800; }
.status-mini.refunded { background: #f5f5f5; color: #999; }
.status-mini.pending { background: #fff3e0; color: #ff9800; }
.status-mini.synced { background: #f0ecfd; color: #8766F3; }
.status-mini.failed { background: #ffeaea; color: #e74c3c; }
.status-mini.not_required { background: #f5f5f5; color: #999; }

/* 分期明细 */
.payment-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.payment-item:last-child { border-bottom: none; }
.payment-item-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.payment-seq {
  font-size: 24rpx;
  color: #8766F3;
  font-weight: 600;
  background: #f0ecfd;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}
.payment-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}
.payment-item-meta {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}
.payment-item-right {
  text-align: right;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}
.payment-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: #ff6b35;
}
.payment-status {
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}
.payment-status.status-paid { background: #f0ecfd; color: #8766F3; }
.payment-status.status-pending { background: #f5f5f5; color: #999; }

.value-success {
  color: #2ecc71;
  font-weight: 600;
}
.value-error {
  color: #e74c3c;
}

