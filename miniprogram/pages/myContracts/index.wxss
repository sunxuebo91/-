.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 0 0 24rpx;
  box-sizing: border-box;
}

.state-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 160rpx;
}
.state-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.state-text { font-size: 32rpx; color: #555; font-weight: 500; }
.state-sub { font-size: 26rpx; color: #999; margin-top: 12rpx; }

.relogin-btn {
  margin-top: 40rpx;
  padding: 20rpx 60rpx;
  background: linear-gradient(135deg, #8766F3 0%, #A694FF 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  box-shadow: 0 6rpx 20rpx rgba(135, 102, 243, 0.3);
}

/* Tab 切换器 */
.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 24rpx;
}
.tab-item {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0 24rpx;
  font-size: 30rpx;
  color: #666;
  font-weight: 500;
  transition: color 0.2s;
}
.tab-item.active {
  color: #8766F3;
  font-weight: 600;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 56rpx;
  height: 6rpx;
  background: #8766F3;
  border-radius: 3rpx;
}

.list { padding: 24rpx 20rpx; }

.contract-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

/* 职培订单卡片：浅青左边框视觉区分 */
.contract-card.card-training {
  border-left: 6rpx solid #4ECDC4;
}

.card-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.kind-tag {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
  flex-shrink: 0;
}
.kind-tag-housekeeping { background: #F0ECFD; color: #8766F3; }
.kind-tag-training { background: #E8F8F5; color: #4ECDC4; }

.value-mono {
  font-family: 'Consolas', 'Monaco', monospace;
  font-size: 24rpx;
}

.value-paid {
  color: #2BB673;
  font-weight: 500;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.service-type {
  font-size: 34rpx;
  font-weight: 600;
  color: #8766F3;
}

.status-badge {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
}
.status-draft     { background: #f0ecfd; color: #8766F3; }
.status-signing   { background: #f0ecfd; color: #8766F3; }
.status-signed    { background: #ece6fd; color: #6b4fc7; }
.status-active    { background: #8766F3; color: #fff; }
.status-ended     { background: #f0f0f0; color: #999; }
.status-cancelled { background: #f5e8f0; color: #a0407a; }
.status-replaced  { background: #f0ecfd; color: #9b7ec8; }

.card-body { margin-bottom: 24rpx; }
.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.label {
  font-size: 26rpx;
  color: #999;
  width: 130rpx;
}
.value {
  font-size: 28rpx;
  color: #333;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}
.arrow { font-size: 40rpx; color: #bbb; }
