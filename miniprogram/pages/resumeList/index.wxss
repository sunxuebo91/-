.page {
  /* 主题紫淡色背景（实色，与导航栏/筛选栏一致），配合白色独立卡片 */
  background: #EDE8FD;
  min-height: 100vh;
}

/* 顶部标题 */
.header {
  background: #EDE8FD; /* 与页面淡紫背景一致 */
  padding: 24rpx 32rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.header-count {
  font-size: 26rpx;
  font-weight: 400;
  color: #333;
}

/* Tab 筛选栏 */
.tabs {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  background: #EDE8FD; /* 与页面淡紫背景一致，固定栏需不透明以遮住滚动内容 */
  border-bottom: 1rpx solid rgba(135, 102, 243, 0.12);
}

/* 筛选按钮行 */
.tabs-row {
  display: flex;
  padding: 0 32rpx;
}

/* 员工版含搜索框时整体不额外撑高，搜索行自带内边距 */
.tabs-with-search {
  /* 无需额外样式，子元素自然撑开 */
}

/* 员工搜索框行 */
.staff-search-row {
  padding: 0 32rpx 16rpx;
}

.staff-search-box {
  display: flex;
  align-items: center;
  background: #ffffff; /* 淡紫背景上用白色输入框，提升对比 */
  border-radius: 32rpx;
  padding: 0 24rpx;
  height: 68rpx;
}

.staff-search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.staff-search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  height: 68rpx;
  line-height: 68rpx;
}

.staff-search-placeholder {
  color: #aaa;
  font-size: 26rpx;
}

.staff-search-clear {
  font-size: 26rpx;
  color: #aaa;
  padding: 0 8rpx;
  flex-shrink: 0;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab.active {
  color: #8766f3;
  font-weight: 600;
}

/* 有筛选条件时的样式 */
.tab.has-filter {
  color: #8766f3;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #8766f3;
  border-radius: 2rpx;
}

.tab-arrow {
  font-size: 20rpx;
  margin-left: 4rpx;
}

/* 自定义底部弹层 */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 9999;
  display: flex;
  align-items: flex-end;
}

.sheet-panel {
  width: 100%;
  background: #fff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
}

.sheet-item {
  padding: 28rpx 0;
  text-align: center;
  font-size: 30rpx;
  color: #333;
  border-bottom: 1rpx solid #f1f1f1;
}

.sheet-item:active {
  background: #f7f5ff;
}

.sheet-cancel {
  margin-top: 16rpx;
  padding: 28rpx 0;
  text-align: center;
  font-size: 30rpx;
  color: #666;
  background: #fff;
}

/* 工种类型弹窗样式 */
.type-sheet {
  padding: 40rpx 32rpx 20rpx;
}

.type-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32rpx 24rpx;
  margin-bottom: 20rpx;
}

.type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.type-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.2s;
}

.type-item:active .type-icon {
  transform: scale(0.95);
}

.icon-img {
  width: 60rpx;
  height: 60rpx;
}

.icon-text {
  font-size: 48rpx;
}

.type-label {
  font-size: 24rpx;
  color: #333;
  text-align: center;
  line-height: 1.3;
}

/* 图标背景色 */
.icon-all {
  background: linear-gradient(135deg, #A0AEC0 0%, #718096 100%);
}

.icon-yuexin {
  background: linear-gradient(135deg, #C4B5FD 0%, #8B5CF6 100%);
}

.icon-yuer {
  background: linear-gradient(135deg, #FCA5A5 0%, #EF4444 100%);
}

.icon-baomu {
  background: linear-gradient(135deg, #FDBA74 0%, #F97316 100%);
}

.icon-xiaoshi {
  background: linear-gradient(135deg, #93C5FD 0%, #3B82F6 100%);
}

.icon-hulao {
  background: linear-gradient(135deg, #86EFAC 0%, #22C55E 100%);
}





/* 简历列表 */
.list {
  padding: 20rpx 32rpx;
  padding-top: 100rpx; /* 为固定筛选栏留出空间（无搜索框） */
}

/* 员工模式：筛选栏多一行搜索框（约 84rpx），整体约 184rpx */
.list.list-with-search {
  padding-top: 186rpx;
}

.card {
  background: #ffffff;
  padding: 24rpx; /* 独立卡片内边距 */
  display: flex;
  gap: 28rpx;
  align-items: stretch; /* 拉伸对齐，让头像跟随内容高度 */
  /* 独立卡片：圆角 + 卡片间留白 + 发丝紫边（与头像呼应）+ 极淡阴影 */
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(135, 102, 243, 0.35);
  box-shadow: 0 2rpx 8rpx rgba(135, 102, 243, 0.06);
}

/* 列表最后一条去掉多余底部留白 */
.list .card:last-child {
  margin-bottom: 0;
}

/* 头像 */
.avatar {
  width: 160rpx;
  height: auto; /* 改为自适应高度 */
  min-height: 160rpx; /* 设置最小高度 */
  aspect-ratio: 3/4; /* 保持3:4的宽高比 */
  border-radius: 12rpx;
  background: #f0f0f0;
  flex-shrink: 0;
  object-fit: cover; /* 确保图片填充方式正确 */
  /* 细主题紫描边：外圈紫色描边 + 极细内描边，呼应整体淡紫主题 */
  box-shadow: 0 0 0 2rpx rgba(135, 102, 243, 0.45), inset 0 0 0 1rpx rgba(0, 0, 0, 0.04);
}

/* 内容区域 */
.content {
  flex: 1;
  display: flex;
  flex-direction: column;
  /* 头部贴顶（对齐头像上边）、标签贴底（对齐头像下边），中间信息行垂直分散 */
  justify-content: space-between;
  gap: 14rpx; /* 作为分布的最小间距，内容紧凑时不至于贴在一起 */
  min-width: 0; /* 防止内容溢出 */
  overflow: visible; /* 确保内容可见 */
}

/* 头部行：左姓名+等级，右上角价格——整体按姓名底部对齐 */
.head-row {
  display: flex;
  align-items: flex-end; /* 价格与姓名行底部对齐 */
  justify-content: space-between;
  gap: 8rpx; /* 收紧间距，给 5 位数价格让出空间，避免徽章换行 */
}

/* 姓名行 */
.name-row {
  display: flex;
  align-items: flex-end; /* 工种徽章底部对齐到姓名底部 */
  gap: 8rpx; /* 收紧姓名与徽章间距 */
  flex-wrap: wrap; /* 允许换行 */
  flex: 1; /* 占满左侧剩余空间，把价格挤到右上角 */
  min-width: 0; /* 允许内容收缩 */
}

.name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F1F1F; /* 比 #333 更沉，主标题更立 */
  flex-shrink: 0; /* 防止姓名被压缩 */
  line-height: 1.2; /* 调整行高，确保与徽章视觉上居中对齐 */
  letter-spacing: 0.5rpx; /* 微字距，提升精致感 */
}

/* 籍贯（“XX人”）：紧跟姓名，弱化为副信息 */
.native {
  font-size: 26rpx;
  font-weight: 400;
  color: #999;
  flex-shrink: 0;
  line-height: 1.2;
}

/* 初级月嫂 */
.badge-junior {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: linear-gradient(135deg, #f0fff4 0%, #9ae6b4 100%);
  color: #2f855a;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 14rpx; /* 与其他等级统一高度 */
  border-radius: 999rpx;
  flex-shrink: 0;
  white-space: nowrap;
  box-shadow: 0 4rpx 12rpx rgba(154, 230, 180, 0.4);
  line-height: 1.2;
}

/* 银牌月嫂 */
.badge-silver {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: linear-gradient(135deg, #e0e0e0 0%, #b0b0b0 100%);
  color: #333;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 14rpx; /* 减小上下padding，让徽章高度更接近姓名文字高度 */
  border-radius: 999rpx;
  flex-shrink: 0;
  white-space: nowrap;
  box-shadow: 0 4rpx 12rpx rgba(176, 176, 176, 0.3);
  text-shadow: 0 1rpx 2rpx rgba(255, 255, 255, 0.5);
  line-height: 1.2; /* 添加行高，确保内部文字垂直居中 */
}

/* 金牌月嫂 */
.badge-gold {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 14rpx; /* 减小上下padding，让徽章高度更接近姓名文字高度 */
  border-radius: 999rpx;
  flex-shrink: 0;
  white-space: nowrap;
  box-shadow: 0 4rpx 12rpx rgba(255, 165, 0, 0.3);
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
  line-height: 1.2; /* 添加行高，确保内部文字垂直居中 */
}

/* 铂金月嫂 */
.badge-platinum {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  /* 改成更有"高端感"的紫色系渐变，而不是普通灰色 */
  background: linear-gradient(135deg, #f5f3ff 0%, #d6bcfa 45%, #9f7aea 100%);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 14rpx; /* 减小上下padding，让徽章高度更接近姓名文字高度 */
  border-radius: 999rpx;
  flex-shrink: 0;
  white-space: nowrap;
  box-shadow: 0 4rpx 12rpx rgba(159, 122, 234, 0.45);
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.15);
  line-height: 1.2; /* 添加行高，确保内部文字垂直居中 */
}

/* 钻石月嫂 */
.badge-diamond {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: linear-gradient(135deg, #B9F2FF 0%, #00D4FF 100%);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 14rpx; /* 减小上下padding，让徽章高度更接近姓名文字高度 */
  border-radius: 999rpx;
  flex-shrink: 0;
  white-space: nowrap;
  box-shadow: 0 4rpx 12rpx rgba(0, 212, 255, 0.3);
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
  line-height: 1.2; /* 添加行高，确保内部文字垂直居中 */
}

/* 皇冠月嫂 */
.badge-crown {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: linear-gradient(135deg, #FF6B9D 0%, #C44569 100%);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 14rpx; /* 减小上下padding，让徽章高度更接近姓名文字高度 */
  border-radius: 999rpx;
  flex-shrink: 0;
  white-space: nowrap;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 157, 0.3);
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
  line-height: 1.2; /* 添加行高，确保内部文字垂直居中 */
}

.badge-junior .icon,
.badge-silver .icon,
.badge-gold .icon,
.badge-platinum .icon,
.badge-diamond .icon,
.badge-crown .icon {
  font-size: 26rpx; /* 减小图标大小，让它更容易居中 */
  line-height: 1; /* 保持行高为1 */
  flex-shrink: 0;
  filter: drop-shadow(0 1rpx 2rpx rgba(0, 0, 0, 0.1));
}

/* 单独微调钻石、皇冠图标在徽章内的垂直位置（这两个 emoji 基线偏低） */
.badge-diamond .icon,
.badge-crown .icon {
  display: inline-block; /* 使用 inline-block 便于位移调整 */
  vertical-align: middle; /* 相对文字垂直对齐 */
  transform: translateY(-2rpx); /* 向上轻微偏移，让图标在背景中视觉居中 */
}

/* 确保标签文本不被压缩 */
.badge-junior text,
.badge-silver text,
.badge-gold text,
.badge-platinum text,
.badge-diamond text,
.badge-crown text {
  flex-shrink: 0;
  letter-spacing: 0.5rpx;
  line-height: 1; /* 统一文字行高为1，与图标保持一致 */
}

/* 基本信息行：籍贯丨年龄丨经验丨学历，竖线分隔，紧凑左对齐排布 */
.meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx; /* 竖线两侧的间距 */
  width: 100%;
  min-width: 0;
  overflow: hidden;
}

/* 信息项之间的竖线分隔符 */
.info-sep {
  font-size: 22rpx;
  color: #e0e0e0;
  line-height: 1.2;
  flex-shrink: 0;
}

/* 工种小勋章：品牌紫渐变填充 + 柔和紫调投影 + 顶部高光，紧跟姓名作为身份标识 */
.job-type {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #a98bf5 0%, #8766f3 100%);
  padding: 6rpx 12rpx; /* 收紧左右内边距，配合一行内排下姓名+徽章 */
  border-radius: 8rpx;
  line-height: 1.2;
  white-space: nowrap;
  letter-spacing: 0.5rpx;
  box-shadow: 0 4rpx 10rpx rgba(135, 102, 243, 0.3), inset 0 1rpx 0 rgba(255, 255, 255, 0.28);
}

/* 信息项：弱化为副信息 */
.info-item {
  flex-shrink: 0; /* 根据内容自然宽度，不再等分布局 */
  font-size: 26rpx;
  color: #999;
  line-height: 1.2;
  white-space: nowrap;
}

/* 如果第一项是工种，可以让它特殊高亮一下，如果你需要的话；目前先统一字体颜色 */
.info-item:first-child {
  /* color: #333; 或者加粗等 */
}

/* 价格行：移至右上角，与姓名顶部对齐 */
.price-row {
  display: flex;
  align-items: baseline;
  color: #E5484D; /* 收敛的高级红，替代偏廉价的亮珊瑚红 */
  flex-shrink: 0;
  padding: 0;
  margin: 0;
}

.price-sym {
  font-size: 24rpx;
  font-weight: 700;
  margin-right: 2rpx;
}

.price-amount {
  font-size: 34rpx; /* 调小，避免数字过大显得扎眼/廉价 */
  font-weight: 700;
  line-height: 1; /* 设置行高为1，减少文字上下留白 */
  letter-spacing: 0.5rpx;
}

.price-unit {
  font-size: 22rpx;
  color: #bbb;
  margin-left: 4rpx;
  font-weight: 400;
}

/* 技能标签 */
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  padding: 0;
  margin-top: 0; /* 紧跟信息行，避免标签少时被推到底部产生大片空白 */
  /* 最多显示 2 行，避免第 3 行被裁掉一半且撑高卡片 */
  overflow: hidden;
  /* 单行高度 = 字号 * 行高 + 上下 padding = 20rpx*1.4 + 12rpx = 40rpx；2行 + 1个 gap */
  max-height: calc((20rpx * 1.4 + 12rpx) * 2 + 8rpx);
}

.tag {
  font-size: 20rpx;
  color: #888; /* 比 #666 更轻，降低噪音 */
  background: #F7F7F9; /* 提亮底色，更安静 */
  padding: 6rpx 14rpx; /* 给松一点，更精致 */
  /* 发丝紫边用内阴影实现，不占布局高度，避免两行标签被裁切 */
  box-shadow: inset 0 0 0 1rpx rgba(135, 102, 243, 0.3);
  border-radius: 8rpx;
  line-height: 1.4; /* 设置行高 */
  white-space: nowrap; /* 防止单个标签内换行 */
}

/* 空状态 */
.empty {
  text-align: center;
  color: #999;
  padding: 100rpx 0;
  font-size: 28rpx;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 40rpx 0;
}

.footer-text {
  font-size: 26rpx;
  color: #999;
}
