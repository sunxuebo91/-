.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx 24rpx 160rpx;
  box-sizing: border-box;
}

/* 订单卡片 */
.order-card {
  background: linear-gradient(135deg, #f0ebff, #e8e0ff);
  border-radius: 20rpx;
  padding: 28rpx 32rpx 20rpx;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #8766F3;
}
.order-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #8766F3;
  margin-bottom: 20rpx;
}
.order-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(135, 102, 243, 0.12);
}
.order-row:last-child { border-bottom: none; }
.order-label { font-size: 26rpx; color: #888; }
.order-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  max-width: 60%;
  text-align: right;
}

/* 表单 */
.form-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 32rpx 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 28rpx;
}
.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-item.last { border-bottom: none; margin-bottom: 16rpx; }
.form-label {
  font-size: 28rpx;
  color: #555;
  display: block;
  margin-bottom: 12rpx;
}
.req { color: #e74c3c; }
.form-input {
  width: 100%;
  font-size: 30rpx;
  color: #222;
  height: 72rpx;
  line-height: 72rpx;
}
.phone-wx-hint {
  font-size: 22rpx;
  color: #27ae60;
  margin-top: 8rpx;
}

/* 微信号码授权按钮 */
.wx-phone-btn {
  margin: 20rpx 0 0;
  padding: 0 24rpx;
  width: 100%;
  box-sizing: border-box;
  background: #f5f0ff;
  color: #8766F3;
  font-size: 26rpx;
  min-height: 72rpx;
  line-height: 1.4;
  border-radius: 36rpx;
  border: 1rpx solid #d9c9ff;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}
.wx-phone-btn::after { border: none; }
.wx-phone-icon { margin-right: 8rpx; }

/* 提示 */
.tip-card {
  background: #fffbe6;
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 24rpx;
}
.tip-text { font-size: 24rpx; color: #b8860b; line-height: 1.7; }

/* 提交按钮 */
.btn-wrap {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 24rpx 32rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}
.submit-btn {
  width: 100%;
  height: 96rpx;
  background: #8766F3;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
}
.btn-disabled { background: #c4b8f5 !important; }
