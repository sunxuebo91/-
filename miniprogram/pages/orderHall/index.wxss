.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 0 0 24rpx;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 20rpx 28rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.filter-picker {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.filter-label { font-size: 26rpx; color: #888; }
.filter-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}
.filter-arrow { font-size: 24rpx; color: #999; }
.filter-action {
  font-size: 26rpx;
  color: #8766F3;
}

/* 列表 */
.list { padding: 20rpx 24rpx; }
.order-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.order-title {
  font-size: 32rpx;
  color: #222;
  font-weight: 600;
  flex: 1;
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.order-tag {
  background: #f0ebff;
  color: #8766F3;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}
/* 已抢单状态角标配色 */
.tag-pending   { background: #fff3e0; color: #f5572b; }
.tag-accepted  { background: #e6f7ec; color: #27ae60; }
.tag-rejected  { background: #fdecea; color: #e74c3c; }
.tag-cancelled { background: #f0f0f0; color: #888;    }

.order-row {
  display: flex;
  align-items: flex-start;
  font-size: 26rpx;
  padding: 6rpx 0;
}
.row-label {
  color: #999;
  width: 80rpx;
  flex-shrink: 0;
}
.row-value {
  color: #333;
  flex: 1;
}
.row-value.salary {
  color: #e74c3c;
  font-weight: 700;
  font-size: 28rpx;
}
.work-row .work-text {
  color: #555;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.order-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}
.grab-count { font-size: 24rpx; color: #999; }
.grab-btn {
  background: #8766F3;
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  font-weight: 600;
}
.grab-btn-done {
  background: #f0f0f0;
  color: #888;
}

.empty, .loading, .footer {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 40rpx 0;
}
