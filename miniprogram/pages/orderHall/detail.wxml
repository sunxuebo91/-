<view class="page" wx:if="{{order}}">
  <view class="status-card status-{{order.status}}">
    <text class="status-text">{{order.statusText}}</text>
    <text class="grab-count">已有 {{order.grabCount}} 人抢单</text>
  </view>

  <view class="card">
    <view class="title-row">
      <text class="title">{{order.title}}</text>
      <text class="type-tag">{{order.serviceTypeLabel}}</text>
    </view>

    <view class="row">
      <text class="label">薪资</text>
      <text class="value salary">{{order.salaryText}}</text>
    </view>
    <view class="row" wx:if="{{order.area}}">
      <text class="label">服务区域</text>
      <text class="value">{{order.area}}</text>
    </view>
    <view class="row" wx:if="{{order.address}}">
      <text class="label">地址</text>
      <text class="value">{{order.address}}</text>
    </view>
    <view class="row" wx:if="{{order.expectedStartText}}">
      <text class="label">上户时间</text>
      <text class="value">{{order.expectedStartText}}</text>
    </view>
    <view class="row" wx:if="{{order.dueDateText}}">
      <text class="label">预产期</text>
      <text class="value">{{order.dueDateText}}</text>
    </view>
    <view class="row" wx:if="{{order.serviceDaysText}}">
      <text class="label">服务天数</text>
      <text class="value">{{order.serviceDaysText}}</text>
    </view>
    <view class="row" wx:if="{{order.babyCountText}}">
      <text class="label">宝宝人数</text>
      <text class="value">{{order.babyCountText}}</text>
    </view>
    <view class="row" wx:if="{{order.workTime}}">
      <text class="label">工作时间</text>
      <text class="value">{{order.workTime}}</text>
    </view>
    <view class="row" wx:if="{{order.orderNo}}">
      <text class="label">订单编号</text>
      <text class="value">{{order.orderNo}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{order.workContent}}">
    <view class="section-title">工作内容</view>
    <view class="paragraph">{{order.workContent}}</view>
  </view>

  <view class="card" wx:if="{{order.requirementsList.length}}">
    <view class="section-title">用户要求</view>
    <view class="row" wx:for="{{order.requirementsList}}" wx:key="label">
      <text class="label">{{item.label}}</text>
      <text class="value">{{item.value}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{order.remark}}">
    <view class="section-title">需求备注</view>
    <view class="paragraph">{{order.remark}}</view>
  </view>

  <view class="tip-card">
    <text class="tip-text">⚠️ 抢单后顾问将联系您安排面试，同一手机号对同一订单仅可抢一次。</text>
  </view>

  <!-- 员工：转发订单 + 生成海报 双按钮 -->
  <view class="btn-wrap" wx:if="{{isStaff}}">
    <view class="btn-row">
      <button class="btn-half btn-outline" open-type="share">转发订单</button>
      <button class="btn-half primary-btn {{posterGenerating ? 'btn-disabled' : ''}}"
              bindtap="onGenerateOrderPoster" disabled="{{posterGenerating}}">
        {{posterGenerating ? '生成中...' : '生成海报'}}
      </button>
    </view>
  </view>

  <!-- 非员工：原抢单按钮 -->
  <view class="btn-wrap" wx:else>
    <button class="primary-btn {{btnDisabled ? 'btn-disabled' : ''}}"
            bindtap="goGrab" disabled="{{btnDisabled}}">
      {{btnText}}
    </button>
  </view>
</view>

<view class="loading" wx:elif="{{loading}}">
  <text>加载中...</text>
</view>

<!-- 海报生成用隐藏 Canvas（2D 模式，定位到屏幕外） -->
<canvas type="2d" id="orderPosterCanvas" style="position:fixed;left:-9999px;top:0;width:375px;height:600px;"></canvas>
