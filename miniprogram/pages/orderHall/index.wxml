<view class="page">
  <!-- 顶部筛选 -->
  <view class="filter-bar">
    <picker mode="selector" range="{{serviceTypes}}" range-key="label"
            value="{{serviceTypeIndex}}" bindchange="onServiceTypeChange">
      <view class="filter-picker">
        <text class="filter-label">工种</text>
        <text class="filter-value">{{serviceTypes[serviceTypeIndex].label}}</text>
        <text class="filter-arrow">▾</text>
      </view>
    </picker>
    <view class="filter-action" bindtap="goMyGrabs">
      <text>我的抢单 ›</text>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="list">
    <view class="order-card" wx:for="{{list}}" wx:key="_id"
          bindtap="goDetail" data-id="{{item._id}}">
      <view class="order-head">
        <text class="order-title">{{item.title || '家政服务订单'}}</text>
        <text wx:if="{{item.grabbedTag}}" class="order-tag {{item.grabbedTagClass}}">{{item.grabbedTag}}</text>
        <text wx:else class="order-tag">{{item.serviceTypeLabel}}</text>
      </view>

      <view class="order-row">
        <text class="row-label">薪资</text>
        <text class="row-value salary">{{item.salaryText}}</text>
      </view>
      <view class="order-row" wx:if="{{item.area}}">
        <text class="row-label">区域</text>
        <text class="row-value">{{item.area}}</text>
      </view>
      <view class="order-row" wx:if="{{item.expectedStartText}}">
        <text class="row-label">上户</text>
        <text class="row-value">{{item.expectedStartText}}</text>
      </view>
      <view class="order-row work-row" wx:if="{{item.workContent}}">
        <text class="row-label">内容</text>
        <text class="row-value work-text">{{item.workContent}}</text>
      </view>

      <view class="order-foot">
        <text class="grab-count">已有 {{item.grabCount}} 人抢单</text>
        <view class="grab-btn {{item.grabbedStatus ? 'grab-btn-done' : ''}}">
          {{item.grabbedStatus ? item.grabbedStatus : '立即抢单'}}
        </view>
      </view>
    </view>

    <!-- 空 / 加载 / 到底 -->
    <view class="empty" wx:if="{{!loading && list.length === 0}}">
      <text>暂无可抢订单</text>
    </view>
    <view class="loading" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
    <view class="footer" wx:if="{{!loading && list.length > 0 && !hasMore}}">
      <text>没有更多了</text>
    </view>
  </view>
</view>
